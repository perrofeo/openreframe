# Export these in your shell, or copy this file to .env (git-ignored) and load it: set -a; . ./.env; set +a
# Comfy Cloud key: https://platform.comfy.org  (API access needs a paid Cloud plan). Not needed on your own ComfyUI.
COMFY_API_KEY=
# Leave empty for Comfy Cloud. For your own ComfyUI: run `comfy-api-proxy` and use http://127.0.0.1:8189
COMFY_BASE_URL=
