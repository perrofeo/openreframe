{
 "image": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "INPUT_IMAGE"
  },
  "_meta": {
   "title": "Middle frame of the shot (cropped)"
  }
 },
 "depth_model": {
  "class_type": "LoadDA3Model",
  "inputs": {
   "model_name": "depth_anything_3_small.safetensors",
   "weight_dtype": "default"
  }
 },
 "depth_run": {
  "class_type": "DA3Inference",
  "inputs": {
   "da3_model": [
    "depth_model",
    0
   ],
   "image": [
    "image",
    0
   ],
   "resolution": 504,
   "resize_method": "upper_bound_resize",
   "mode": "mono"
  }
 },
 "depth": {
  "class_type": "DA3Render",
  "inputs": {
   "da3_geometry": [
    "depth_run",
    0
   ],
   "output": "depth",
   "output.normalization": "v2_style",
   "output.apply_sky_clip": false
  }
 },
 "save_depth": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "depth",
    0
   ],
   "filename_prefix": "openreframe/depth"
  }
 },
 "caption": {
  "class_type": "AILab_QwenVL",
  "inputs": {
   "model_name": "Qwen3-VL-4B-Instruct",
   "quantization": "None (FP16)",
   "attention_mode": "auto",
   "preset_prompt": "🖼️ Detailed Description",
   "custom_prompt": "CAPTION_INSTRUCTION",
   "max_tokens": 200,
   "keep_model_loaded": false,
   "seed": 1,
   "image": [
    "image",
    0
   ]
  }
 },
 "save_caption": {
  "class_type": "SaveText",
  "inputs": {
   "text": [
    "caption",
    0
   ],
   "filename_prefix": "openreframe/caption",
   "format": "txt"
  }
 },
 "sky_model": {
  "class_type": "LoadDA3Model",
  "inputs": {
   "model_name": "depth_anything_3_mono_large.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "Mono model: has a sky mask"
  }
 },
 "sky_run": {
  "class_type": "DA3Inference",
  "inputs": {
   "da3_model": [
    "sky_model",
    0
   ],
   "image": [
    "image",
    0
   ],
   "resolution": 504,
   "resize_method": "upper_bound_resize",
   "mode": "mono"
  }
 },
 "sky": {
  "class_type": "DA3Render",
  "inputs": {
   "da3_geometry": [
    "sky_run",
    0
   ],
   "output": "sky_mask",
   "output.colored": false
  }
 },
 "save_sky": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "sky",
    0
   ],
   "filename_prefix": "openreframe/sky"
  }
 }
}